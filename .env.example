# Copy this file to .env and replace every value. .env is gitignored - never commit it.
#   cp .env.example .env

# PostgreSQL (used by both the db container and the API's connection string)
POSTGRES_USER=careemr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=careemr

# JWT signing key: a random string of at least 32 characters.
# Generate one with:  openssl rand -base64 64
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-characters

# DEMO ONLY: the single login accepted by POST /api/auth/login
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me
