{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Non-secret JWT settings. Jwt:SigningKey is a SECRET: set it in User Secrets
  // (local dev) or the .env file (Docker), never here.
  "Jwt": {
    "Issuer": "CareEMR.Api",
    "Audience": "CareEMR.Api",
    "ExpiryMinutes": 60
  }

  // DEMO ONLY: DemoUser:Username and DemoUser:Password also come from User Secrets / .env.
  // A real system would use a user database or an identity provider instead.
}
