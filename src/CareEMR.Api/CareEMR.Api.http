@CareEMR.Api_HostAddress = http://localhost:5082

# DEMO ONLY: fill these in from your User Secrets locally, and DON'T commit real values:
#   dotnet user-secrets list --project src/CareEMR.Api
@demoUsername = demo
@demoPassword = <your DemoUser:Password>

# FAKE TEST DATA ONLY - never use real patient information here.
# Run "Log in" first: every /api/patients request reuses its token.
# Then run request 1; later requests reuse the id it returns.
# Health card numbers must be unique, so change "healthCardNumber" in request 1
# if you run it again (otherwise you get 409 Conflict).

### 0. Log in (expect 200 OK with an accessToken)
# @name login
POST {{CareEMR.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "{{demoUsername}}",
  "password": "{{demoPassword}}"
}

### 0b. No token (expect 401 Unauthorized)
GET {{CareEMR.Api_HostAddress}}/api/patients
Accept: application/json

### 1. Create a patient (expect 201 Created)
# @name createPatient
POST {{CareEMR.Api_HostAddress}}/api/patients
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "Patient",
  "dateOfBirth": "1985-04-12",
  "healthCardNumber": "2222-333-444",
  "healthCardVersionCode": "ab",
  "phone": "555-0100",
  "email": "test.patient@example.com"
}

### 2. List all active patients (expect 200 OK)
GET {{CareEMR.Api_HostAddress}}/api/patients
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### 3. Get the patient created in request 1 (expect 200 OK)
GET {{CareEMR.Api_HostAddress}}/api/patients/{{createPatient.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### 4. Update the patient (expect 200 OK). PUT replaces all fields: omitted optional fields are cleared.
PUT {{CareEMR.Api_HostAddress}}/api/patients/{{createPatient.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Testy",
  "lastName": "Patient-Updated",
  "dateOfBirth": "1985-04-13",
  "healthCardNumber": "2222333444",
  "healthCardVersionCode": "CD",
  "phone": "555-0199",
  "email": "updated.patient@example.com"
}

### 5. Update with invalid data (expect 400 Bad Request)
PUT {{CareEMR.Api_HostAddress}}/api/patients/{{createPatient.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Testy",
  "lastName": "Patient",
  "dateOfBirth": "2999-01-01"
}

### 6. Soft delete the patient (expect 204 No Content)
DELETE {{CareEMR.Api_HostAddress}}/api/patients/{{createPatient.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### 7. Deleted patient is now hidden (expect 404 Not Found)
GET {{CareEMR.Api_HostAddress}}/api/patients/{{createPatient.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### 8. Unknown id (expect 404 Not Found)
GET {{CareEMR.Api_HostAddress}}/api/patients/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### 9. Reuse a health card that's already taken (expect 409 Conflict)
POST {{CareEMR.Api_HostAddress}}/api/patients
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Another",
  "lastName": "Tester",
  "dateOfBirth": "1990-01-01",
  "healthCardNumber": "2222333444"
}

### 10. Invalid health card (expect 400 Bad Request)
POST {{CareEMR.Api_HostAddress}}/api/patients
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Bad",
  "lastName": "Card",
  "dateOfBirth": "1990-01-01",
  "healthCardNumber": "12345"
}
